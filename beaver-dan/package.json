{
  "name": "beaver-dan",
  "version": "0.1.0",
  "description": "Beaver Dan — an artful, true-to-nature game about the life of a beaver. Play as Dan: swim, gnaw, build dams, raise a family, and transform a valley.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync"
  },
  "keywords": [
    "game",
    "beaver",
    "wildlife",
    "education",
    "phaser",
    "capacitor",
    "ios",
    "android"
  ],
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "puppeteer": "^25.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
